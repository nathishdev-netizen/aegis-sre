# Copy to .env and fill in. .env is gitignored - never commit real keys.
#   cp .env.example .env

# --- AI interpretation -------------------------------------------------------
# Without a key the agent runs in "pattern mode": it reports which patterns matched,
# shows no confidence score, and answers questions with "unknown" instead of guessing.
OPENAI_API_KEY=

# Model used for the run summary and ask-this-run answers.
LOG_AGENT_MODEL=gpt-4o-mini

# Set to false to force pattern mode even when a key is present.
LOG_AGENT_LLM=true

# --- Server ------------------------------------------------------------------
LOG_AGENT_HOST=127.0.0.1
LOG_AGENT_PORT=3000

# --- Source attachment -------------------------------------------------------
# Automatically attach to the most likely local source on startup.
LOG_AGENT_AUTO_ATTACH=true

# Endpoints probed when attaching to a port, in order (comma-separated).
LOG_AGENT_PROBE_PATHS=/events,/stream,/logs/stream,/api/events,/api/logs,/logs,/debug/logs

# --- Limits ------------------------------------------------------------------
# Log lines and timeline entries retained in memory.
LOG_AGENT_MAX_LOG_LINES=200
LOG_AGENT_MAX_TIMELINE=60

# How much of the run is sent to the model for interpretation.
LOG_AGENT_LLM_LOG_WINDOW=60
LOG_AGENT_LLM_TIMELINE_WINDOW=30
