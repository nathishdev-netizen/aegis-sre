# Secrets - never commit
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Logs / scratch
*.log
# ...except the one example the README is built around. Every number in
# that document comes from this file, so it has to ship with the repo.
!examples/shipyard.log
logs/

# Build artifacts - rebuildable, and the .app bundles a copy of .env with the API key
Log Agent.app/
desktop-app/node_modules/
desktop-app/dist/
node_modules/
.agent.log
.venv/

# Screenshots and local exports - never part of the project
*.png
*.jpg
*.jpeg
data_exported_*.jsonl
.claude/settings.local.json
.claude/settings.json
private/
tmp/
vtest2.js
pipe.py

# The demo video's own assets are the exception to the image ignores above:
# walkthrough.html renders shots/, and build.py rebuilds the video from
# ui/vid/. Without them the published page is broken links and the video
# cannot be regenerated from a fresh clone.
!demo-video/shots/*.jpg
!demo-video/ui/vid/*.png

# The rendered video ships as a GitHub release asset, not in the tree: a
# 26MB binary in every clone is a tax on anyone who just wants the code.
# Rebuild it with: python3 demo-video/build.py
demo-video/out/*.mp4
