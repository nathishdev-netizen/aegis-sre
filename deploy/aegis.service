[Unit]
Description=Aegis - log intelligence that closes the loop
Documentation=https://github.com/nathishdev-netizen/aegis-sre
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Discovery runs `lsof` to list every listening port and find the log each
# process has open. A user can only see its OWN processes that way, so as a
# dedicated `aegis` user the port list came back empty on a box running
# anything interesting. root sees them all.
#
# The trade is real, so it is stated: this reads your logs as root. The
# hardening below is what bounds it - the filesystem is read-only apart
# from its own state directory, and it can gain no new privileges. To run
# unprivileged instead, set User=aegis and accept that the port list will
# be empty; attaching by path still works.
User=root
WorkingDirectory=/opt/aegis
Environment=PYTHONUNBUFFERED=1
# The model key. Absent, everything still runs and the reasoning layer
# simply returns nothing - detection never depended on it.
EnvironmentFile=-/opt/aegis/.env

# The app binds 127.0.0.1:3000 by default and is reached through nginx.
# Both are overridable here rather than in code: a box where 3000 is taken
# needs a port change, not a patch.
Environment=LOG_AGENT_HOST=127.0.0.1
Environment=LOG_AGENT_PORT=3000

# run.py is the whole product: the dashboard, the Aegis engine behind it,
# and the source picker. Sources are attached from the browser and the
# last one is remembered in ~/.loganalyst-session.json, so a restart
# resumes watching rather than coming back empty.
ExecStart=/usr/bin/python3 /opt/aegis/run.py

Restart=always
RestartSec=5
# If it cannot stay up for five minutes across five tries, something is
# wrong that restarting will not fix - stop and leave the logs intact.
StartLimitIntervalSec=300
StartLimitBurst=5

KillSignal=SIGTERM
TimeoutStopSec=30

# Running as root makes this hardening load-bearing rather than optional.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: PM2 and many app servers write their logs under a
# user's home, and `true` hides those directories entirely - the one place
# this box's own service logs actually live.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Where ~/.aegis and the session file live.
StateDirectory=aegis
Environment=HOME=/var/lib/aegis
# The log directories it may read. Add a line per path outside these.
ReadOnlyPaths=/var/log /home
ReadWritePaths=/var/lib/aegis

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis

[Install]
WantedBy=multi-user.target
